{
  "name": "your-turn",
  "displayName": "Your Turn",
  "description": "Work with coding agents and understand their changes, one turn at a time.",
  "version": "0.4.0",
  "publisher": "eeeggg",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "resources/icon.png",
  "bugs": {
    "url": "https://github.com/eeeggg/your-turn/issues",
    "email": "eric@6r4f.com"
  },
  "homepage": "https://github.com/eeeggg/your-turn",
  "repository": {
    "type": "git",
    "url": "https://github.com/eeeggg/your-turn.git"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "AI",
    "Chat",
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "review",
    "code review",
    "diff",
    "diff review",
    "code changes",
    "workflow",
    "agent workflow",
    "human in the loop",
    "ai",
    "ai coding",
    "agent",
    "coding agent",
    "agentic coding",
    "chat",
    "acp",
    "agent client protocol"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/extension.js",
    "dist/webview/chat.js",
    "dist/webview/chat.css",
    "dist/ThirdPartyNotices.txt",
    "resources/icon.png",
    "resources/icon.svg",
    "README.md",
    "CHANGELOG.md",
    "NOTICE",
    "LICENSE"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "your-turn",
          "title": "Your Turn",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "your-turn": [
        {
          "id": "your-turn-sessions",
          "name": "Agents",
          "type": "tree",
          "icon": "$(hubot)"
        },
        {
          "id": "your-turn-chat",
          "name": "Chat",
          "type": "webview",
          "icon": "$(comment-discussion)",
          "when": "!your-turn.workspaceUnavailable"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "your-turn-sessions",
        "contents": "No agents configured.\n[Add Agent](command:your-turn.addAgent)\n[Detect Agents](command:your-turn.detectAgents)\nDetect Agents looks on your PATH for agents from the ACP registry.",
        "when": "!your-turn.showingOtherWorkspaces && your-turn.noAgentsConfigured"
      },
      {
        "view": "your-turn-sessions",
        "contents": "Your Turn runs agents in a folder, and this window has none.\n[Open Folder](command:workbench.action.files.openFolder)",
        "when": "!your-turn.showingOtherWorkspaces && your-turn.workspaceUnavailable == empty"
      },
      {
        "view": "your-turn-sessions",
        "contents": "Your Turn needs this workspace saved, so its sessions can be found when it is opened again.\n[Save Workspace As...](command:workbench.action.saveWorkspaceAs)",
        "when": "!your-turn.showingOtherWorkspaces && your-turn.workspaceUnavailable == untitled"
      },
      {
        "view": "your-turn-sessions",
        "contents": "Your Turn runs agents in the workspace's first folder, which must be on disk. This one is in a virtual file system.\n[Open Folder](command:workbench.action.files.openFolder)",
        "when": "!your-turn.showingOtherWorkspaces && your-turn.workspaceUnavailable == virtual"
      },
      {
        "view": "your-turn-sessions",
        "contents": "No sessions in other workspaces yet.\nSessions used in other workspaces appear here, and open in their workspace's window.",
        "when": "your-turn.showingOtherWorkspaces"
      }
    ],
    "commands": [
      {
        "command": "your-turn.connectAgent",
        "title": "Your Turn: Connect to Agent",
        "icon": "$(plug)"
      },
      {
        "command": "your-turn.newSession",
        "title": "Your Turn: New Session",
        "icon": "$(add)"
      },
      {
        "command": "your-turn.sendPrompt",
        "title": "Your Turn: Send Prompt"
      },
      {
        "command": "your-turn.cancelTurn",
        "title": "Your Turn: Cancel Current Turn",
        "icon": "$(debug-stop)"
      },
      {
        "command": "your-turn.disconnectAgent",
        "title": "Your Turn: Disconnect Agent",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "your-turn.openChat",
        "title": "Your Turn: Open Chat View"
      },
      {
        "command": "your-turn.addAgent",
        "title": "Your Turn: Add Agent Configuration",
        "icon": "$(add)"
      },
      {
        "command": "your-turn.showOtherWorkspaces",
        "title": "Your Turn: Show Other Workspaces",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "your-turn.showAgents",
        "title": "Your Turn: Show This Workspace's Agents",
        "icon": "$(arrow-left)"
      },
      {
        "command": "your-turn.openSessionInWorkspace",
        "title": "Your Turn: Open Session in Its Workspace"
      },
      {
        "command": "your-turn.detectAgents",
        "title": "Your Turn: Detect Agents"
      },
      {
        "command": "your-turn.removeAgent",
        "title": "Your Turn: Remove Agent"
      },
      {
        "command": "your-turn.showLog",
        "title": "Your Turn: Show Log"
      },
      {
        "command": "your-turn.exportTraffic",
        "title": "Your Turn: Export Protocol Traffic"
      },
      {
        "command": "your-turn.showPersistedState",
        "title": "Your Turn (Developer): Show Persisted State"
      },
      {
        "command": "your-turn.resetPersistedState",
        "title": "Your Turn (Developer): Reset Persisted State"
      },
      {
        "command": "your-turn.setMode",
        "title": "Your Turn: Set Agent Mode"
      },
      {
        "command": "your-turn.setModel",
        "title": "Your Turn: Set Agent Model"
      },
      {
        "command": "your-turn.attachFile",
        "title": "Your Turn: Attach File to Prompt",
        "icon": "$(attach)"
      },
      {
        "command": "your-turn.refreshSessions",
        "title": "Your Turn: Refresh Sessions"
      },
      {
        "command": "your-turn.openSession",
        "title": "Your Turn: Open Session"
      },
      {
        "command": "your-turn.loadMoreSessions",
        "title": "Your Turn: Load More Sessions"
      },
      {
        "command": "your-turn.copySessionId",
        "title": "Copy Session ID"
      },
      {
        "command": "your-turn.removeFromHistory",
        "title": "Remove from History"
      },
      {
        "command": "your-turn.restartAgent",
        "title": "Your Turn: Restart Agent",
        "icon": "$(debug-restart)"
      },
      {
        "command": "your-turn.openToolCallFile",
        "title": "Open File"
      },
      {
        "command": "your-turn.openToolCallChanges",
        "title": "Open Changes"
      },
      {
        "command": "your-turn.openCommandOutput",
        "title": "Open in Terminal"
      },
      {
        "command": "your-turn.openReview",
        "title": "Open Review",
        "icon": "$(diff)",
        "enablement": "your-turn.reviewShown && your-turn.reviewHasFiles && !your-turn.turnInProgress"
      },
      {
        "command": "your-turn.previousReviewFile",
        "title": "Previous File Under Review",
        "icon": "$(arrow-left)",
        "enablement": "your-turn.reviewShown && your-turn.reviewHasFiles"
      },
      {
        "command": "your-turn.nextReviewFile",
        "title": "Next File Under Review",
        "icon": "$(arrow-right)",
        "enablement": "your-turn.reviewShown && your-turn.reviewHasFiles"
      },
      {
        "command": "your-turn.undoFile",
        "title": "Undo File",
        "icon": "$(discard)",
        "enablement": "your-turn.reviewShown && resource in your-turn.reviewedFiles && !your-turn.turnInProgress"
      },
      {
        "command": "your-turn.keepFile",
        "title": "Keep File",
        "icon": "$(check)",
        "enablement": "your-turn.reviewShown && resource in your-turn.reviewedFiles && !your-turn.turnInProgress"
      },
      {
        "command": "your-turn.keepAllFiles",
        "title": "Keep All",
        "icon": "$(check-all)",
        "enablement": "your-turn.reviewShown && your-turn.reviewHasFiles && !your-turn.turnInProgress"
      },
      {
        "command": "your-turn.undoDiffChange",
        "title": "Undo Change",
        "icon": "$(discard)",
        "enablement": "your-turn.reviewDiffChange && !your-turn.turnInProgress"
      },
      {
        "command": "your-turn.keepDiffChange",
        "title": "Keep Change",
        "icon": "$(check)",
        "enablement": "your-turn.reviewDiffChange && !your-turn.turnInProgress"
      },
      {
        "command": "your-turn.undoChange",
        "title": "Undo Change",
        "icon": "$(discard)",
        "enablement": "!your-turn.turnInProgress"
      },
      {
        "command": "your-turn.keepChange",
        "title": "Keep Change",
        "icon": "$(check)",
        "enablement": "!your-turn.turnInProgress"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "your-turn.connectAgent",
          "when": "!your-turn.workspaceUnavailable"
        },
        {
          "command": "your-turn.newSession",
          "when": "!your-turn.workspaceUnavailable"
        },
        {
          "command": "your-turn.sendPrompt",
          "when": "!your-turn.workspaceUnavailable"
        },
        {
          "command": "your-turn.cancelTurn",
          "when": "!your-turn.workspaceUnavailable"
        },
        {
          "command": "your-turn.disconnectAgent",
          "when": "!your-turn.workspaceUnavailable"
        },
        {
          "command": "your-turn.openChat",
          "when": "!your-turn.workspaceUnavailable"
        },
        {
          "command": "your-turn.addAgent",
          "when": "!your-turn.workspaceUnavailable"
        },
        {
          "command": "your-turn.detectAgents",
          "when": "!your-turn.workspaceUnavailable"
        },
        {
          "command": "your-turn.removeAgent",
          "when": "!your-turn.workspaceUnavailable"
        },
        {
          "command": "your-turn.showLog",
          "when": "!your-turn.workspaceUnavailable"
        },
        {
          "command": "your-turn.exportTraffic",
          "when": "!your-turn.workspaceUnavailable"
        },
        {
          "command": "your-turn.showPersistedState",
          "when": "!your-turn.workspaceUnavailable"
        },
        {
          "command": "your-turn.resetPersistedState",
          "when": "!your-turn.workspaceUnavailable"
        },
        {
          "command": "your-turn.setMode",
          "when": "!your-turn.workspaceUnavailable"
        },
        {
          "command": "your-turn.setModel",
          "when": "!your-turn.workspaceUnavailable"
        },
        {
          "command": "your-turn.attachFile",
          "when": "!your-turn.workspaceUnavailable"
        },
        {
          "command": "your-turn.restartAgent",
          "when": "!your-turn.workspaceUnavailable"
        },
        {
          "command": "your-turn.openReview",
          "when": "!your-turn.workspaceUnavailable && your-turn.reviewShown && your-turn.reviewHasFiles"
        },
        {
          "command": "your-turn.keepDiffChange",
          "when": "false"
        },
        {
          "command": "your-turn.undoDiffChange",
          "when": "false"
        },
        {
          "command": "your-turn.refreshSessions",
          "when": "false"
        },
        {
          "command": "your-turn.showOtherWorkspaces",
          "when": "false"
        },
        {
          "command": "your-turn.showAgents",
          "when": "false"
        },
        {
          "command": "your-turn.openSessionInWorkspace",
          "when": "false"
        },
        {
          "command": "your-turn.openSession",
          "when": "false"
        },
        {
          "command": "your-turn.loadMoreSessions",
          "when": "false"
        },
        {
          "command": "your-turn.copySessionId",
          "when": "false"
        },
        {
          "command": "your-turn.removeFromHistory",
          "when": "false"
        },
        {
          "command": "your-turn.openToolCallFile",
          "when": "false"
        },
        {
          "command": "your-turn.openToolCallChanges",
          "when": "false"
        },
        {
          "command": "your-turn.openCommandOutput",
          "when": "false"
        },
        {
          "command": "your-turn.previousReviewFile",
          "when": "false"
        },
        {
          "command": "your-turn.nextReviewFile",
          "when": "false"
        },
        {
          "command": "your-turn.undoFile",
          "when": "false"
        },
        {
          "command": "your-turn.keepFile",
          "when": "false"
        },
        {
          "command": "your-turn.keepAllFiles",
          "when": "false"
        },
        {
          "command": "your-turn.undoChange",
          "when": "false"
        },
        {
          "command": "your-turn.keepChange",
          "when": "false"
        }
      ],
      "scm/change/title": [
        {
          "command": "your-turn.undoChange",
          "when": "originalResourceScheme == review-baseline",
          "group": "navigation@1"
        },
        {
          "command": "your-turn.keepChange",
          "when": "originalResourceScheme == review-baseline",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "your-turn.openReview",
          "when": "!your-turn.workspaceUnavailable && config.your-turn.review.presentation == diffEditor && your-turn.reviewShown && your-turn.reviewHasFiles && activeEditor == workbench.editors.files.textFileEditor && isFileSystemResource && !textCompareEditorActive",
          "group": "navigation@-1"
        },
        {
          "command": "your-turn.previousReviewFile",
          "when": "!your-turn.workspaceUnavailable && (config.your-turn.review.presentation == diffEditor && textCompareEditorActive && diffEditorOriginalUri =~ /^your-turn-review-diff:/ || config.your-turn.review.presentation == quickDiff && activeEditor == workbench.editors.files.textFileEditor)",
          "group": "navigation@-5"
        },
        {
          "command": "your-turn.nextReviewFile",
          "when": "!your-turn.workspaceUnavailable && (config.your-turn.review.presentation == diffEditor && textCompareEditorActive && diffEditorOriginalUri =~ /^your-turn-review-diff:/ || config.your-turn.review.presentation == quickDiff && activeEditor == workbench.editors.files.textFileEditor)",
          "group": "navigation@-4"
        },
        {
          "command": "your-turn.undoFile",
          "when": "!your-turn.workspaceUnavailable && (config.your-turn.review.presentation == diffEditor && textCompareEditorActive && diffEditorOriginalUri =~ /^your-turn-review-diff:/ || config.your-turn.review.presentation == quickDiff && activeEditor == workbench.editors.files.textFileEditor)",
          "group": "navigation@-3"
        },
        {
          "command": "your-turn.keepFile",
          "when": "!your-turn.workspaceUnavailable && (config.your-turn.review.presentation == diffEditor && textCompareEditorActive && diffEditorOriginalUri =~ /^your-turn-review-diff:/ || config.your-turn.review.presentation == quickDiff && activeEditor == workbench.editors.files.textFileEditor)",
          "group": "navigation@-2"
        },
        {
          "command": "your-turn.keepAllFiles",
          "when": "!your-turn.workspaceUnavailable && (config.your-turn.review.presentation == diffEditor && textCompareEditorActive && diffEditorOriginalUri =~ /^your-turn-review-diff:/ || config.your-turn.review.presentation == quickDiff && activeEditor == workbench.editors.files.textFileEditor)",
          "group": "navigation@-1"
        }
      ],
      "webview/context": [
        {
          "command": "your-turn.openToolCallFile",
          "when": "webviewId == 'your-turn-chat' && webviewSection == 'toolCallDiffFile'",
          "group": "navigation@1"
        },
        {
          "command": "your-turn.openToolCallChanges",
          "when": "webviewId == 'your-turn-chat' && webviewSection == 'toolCallDiffFile' && yourTurnDiffFileHasLines",
          "group": "navigation@2"
        },
        {
          "command": "your-turn.openCommandOutput",
          "when": "webviewId == 'your-turn-chat' && webviewSection == 'commandOutput'",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "your-turn.showOtherWorkspaces",
          "when": "view == your-turn-sessions && !your-turn.showingOtherWorkspaces",
          "group": "navigation@0"
        },
        {
          "command": "your-turn.showAgents",
          "when": "view == your-turn-sessions && your-turn.showingOtherWorkspaces",
          "group": "navigation@0"
        },
        {
          "command": "your-turn.addAgent",
          "when": "!your-turn.workspaceUnavailable && !your-turn.showingOtherWorkspaces && view == your-turn-sessions",
          "group": "navigation@1"
        },
        {
          "command": "your-turn.newSession",
          "when": "view == your-turn-chat",
          "group": "navigation@1"
        },
        {
          "command": "your-turn.attachFile",
          "when": "view == your-turn-chat",
          "group": "navigation@2"
        },
        {
          "command": "your-turn.cancelTurn",
          "when": "view == your-turn-chat && your-turn.turnInProgress",
          "group": "navigation@3"
        },
        {
          "command": "your-turn.disconnectAgent",
          "when": "view == your-turn-chat",
          "group": "navigation@4"
        },
        {
          "command": "your-turn.showLog",
          "when": "view == your-turn-chat"
        },
        {
          "command": "your-turn.exportTraffic",
          "when": "view == your-turn-chat"
        },
        {
          "command": "your-turn.restartAgent",
          "when": "view == your-turn-chat"
        }
      ],
      "view/item/context": [
        {
          "command": "your-turn.newSession",
          "when": "view == your-turn-sessions && viewItem =~ /^agent/",
          "group": "session@0"
        },
        {
          "command": "your-turn.connectAgent",
          "when": "view == your-turn-sessions && viewItem == agent-without-session",
          "group": "inline"
        },
        {
          "command": "your-turn.disconnectAgent",
          "when": "view == your-turn-sessions && viewItem == agent-with-session",
          "group": "inline"
        },
        {
          "command": "your-turn.removeAgent",
          "when": "view == your-turn-sessions && viewItem =~ /^agent/"
        },
        {
          "command": "your-turn.restartAgent",
          "when": "view == your-turn-sessions && viewItem == agent-with-session"
        },
        {
          "command": "your-turn.refreshSessions",
          "when": "view == your-turn-sessions && viewItem =~ /^agent/",
          "group": "session@1"
        },
        {
          "command": "your-turn.copySessionId",
          "when": "view == your-turn-sessions && viewItem =~ /^session/",
          "group": "session@1"
        },
        {
          "command": "your-turn.removeFromHistory",
          "when": "view == your-turn-sessions && viewItem == session-local",
          "group": "session@2"
        }
      ]
    },
    "configurationDefaults": {
      "diffEditor.codeLens": true
    },
    "configuration": {
      "title": "Your Turn",
      "properties": {
        "your-turn.review.presentation": {
          "type": "string",
          "enum": [
            "quickDiff",
            "diffEditor"
          ],
          "default": "diffEditor",
          "description": "Review agent changes in a native diff editor with per-change CodeLens and editor title controls, or in the inline quick diff view."
        },
        "your-turn.agents": {
          "type": "object",
          "description": "Agent configurations. Each key is the agent name, value has command, args, and env.",
          "default": {}
        },
        "your-turn.autoApprovePermissions": {
          "type": "string",
          "enum": [
            "ask",
            "allowAll"
          ],
          "default": "ask",
          "description": "Automatically approve agent permission requests. 'ask' always prompts, 'allowAll' approves everything."
        },
        "your-turn.includeActiveFile": {
          "type": "boolean",
          "default": false,
          "order": 1,
          "description": "Attach the currently active editor file to each prompt as a resource_link content block."
        },
        "your-turn.activeFileExcludes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": [],
          "order": 2,
          "markdownDescription": "Exclude matching files from automatic active-file attachment. Only applies when `#your-turn.includeActiveFile#` is enabled; turning it off retains this list.\n\nPatterns match at any directory depth, like VS Code Search (an initial `**/` is assumed). Examples: `.env` (that filename), `.env.*` (such as `.env.local`), `*.pem` (PEM files), `secrets/**` (files inside directories named secrets). Add one pattern per item."
        },
        "your-turn.logTraffic": {
          "type": "boolean",
          "default": false,
          "description": "Capture ACP protocol traffic in memory for explicit JSONL export."
        },
        "your-turn.showToolCallDiffs": {
          "type": "boolean",
          "default": false,
          "description": "Show the diffs an agent reports in its tool calls in the chat view: what the agent said each tool call changed, when it said it. Applies from the next tool call update."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:production",
    "compile": "node tools/run-tests.mjs compile",
    "check": "node tools/run-tests.mjs check",
    "typecheck": "tsc -b",
    "build:production": "npm run typecheck && node esbuild.mjs --production && npm run notices",
    "notices": "node tools/notices.mjs",
    "lint": "eslint . --max-warnings 0 && knip",
    "test": "node tools/run-tests.mjs test",
    "test:unit": "node tools/run-tests.mjs test:unit",
    "test:in-process": "node tools/run-tests.mjs test:in-process",
    "test:webview": "node tools/run-tests.mjs test:webview",
    "test:integration": "node tools/run-tests.mjs test:integration",
    "test:ui": "node tools/run-tests.mjs test:ui",
    "test:unit:only": "node tools/run-tests.mjs test:unit:only",
    "test:webview:only": "node tools/run-tests.mjs test:webview:only",
    "test:integration:only": "node tools/run-tests.mjs test:integration:only",
    "test:ui:only": "node tools/run-tests.mjs test:ui:only",
    "coverage": "node tools/run-tests.mjs coverage",
    "coverage:integration": "node tools/run-tests.mjs coverage:integration",
    "package:vsix": "vsce package",
    "package:ci": "node tools/package-ci.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.1.0",
    "@xterm/headless": "^6.0.0",
    "currency-codes": "^2.2.0",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "execa": "^10.2.0",
    "image-size": "^2.0.4",
    "lucide-react": "^1.70.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-diff-view": "^3.3.3",
    "react-dom": "^19.3.1",
    "streamdown": "^2.7.1",
    "to-words": "^7.4.1",
    "use-stick-to-bottom": "^1.1.6",
    "which": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/hosted-git-info": "^3.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "~1.140.0",
    "@types/vscode-webview": "^1.57.5",
    "@types/which": "^3.0.4",
