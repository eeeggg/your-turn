{
  "name": "acp-client",
  "displayName": "ACP Client",
  "description": "Agent Client Protocol client for VS Code — connect to any ACP-compatible AI coding agent",
  "version": "0.3.21-dev.3",
  "publisher": "formulahendry",
  "license": "MIT",
  "icon": "resources/icon.png",
  "bugs": {
    "url": "https://github.com/formulahendry/vscode-acp/issues",
    "email": "formulahendry@gmail.com"
  },
  "homepage": "https://github.com/formulahendry/vscode-acp/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/formulahendry/vscode-acp.git"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "acp",
    "agent",
    "ai",
    "coding agent",
    "copilot"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "acp-client",
          "title": "ACP Client",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "acp-client": [
        {
          "id": "acp-sessions",
          "name": "Agents",
          "type": "tree",
          "icon": "$(hubot)"
        },
        {
          "id": "acp-chat",
          "name": "Chat",
          "type": "webview",
          "icon": "$(comment-discussion)",
          "when": "!acp.workspaceUnavailable"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "acp-sessions",
        "contents": "No agents configured.\n[Add Agent](command:acp.addAgent)\n[Detect Agents](command:acp.detectAgents)\nDetect Agents looks on your PATH for agents from the ACP registry.",
        "when": "!acp.showingOtherWorkspaces && acp.noAgentsConfigured"
      },
      {
        "view": "acp-sessions",
        "contents": "ACP Client runs agents in a folder, and this window has none.\n[Open Folder](command:workbench.action.files.openFolder)",
        "when": "!acp.showingOtherWorkspaces && acp.workspaceUnavailable == empty"
      },
      {
        "view": "acp-sessions",
        "contents": "ACP Client needs this workspace saved, so its sessions can be found when it is opened again.\n[Save Workspace As...](command:workbench.action.saveWorkspaceAs)",
        "when": "!acp.showingOtherWorkspaces && acp.workspaceUnavailable == untitled"
      },
      {
        "view": "acp-sessions",
        "contents": "ACP Client runs agents in the workspace's first folder, which must be on disk. This one is in a virtual file system.\n[Open Folder](command:workbench.action.files.openFolder)",
        "when": "!acp.showingOtherWorkspaces && acp.workspaceUnavailable == virtual"
      },
      {
        "view": "acp-sessions",
        "contents": "No sessions in other workspaces yet.\nSessions used in other workspaces appear here, and open in their workspace's window.",
        "when": "acp.showingOtherWorkspaces"
      }
    ],
    "commands": [
      {
        "command": "acp.connectAgent",
        "title": "ACP: Connect to Agent",
        "icon": "$(plug)"
      },
      {
        "command": "acp.newSession",
        "title": "ACP: New Session",
        "icon": "$(add)"
      },
      {
        "command": "acp.sendPrompt",
        "title": "ACP: Send Prompt"
      },
      {
        "command": "acp.cancelTurn",
        "title": "ACP: Cancel Current Turn",
        "icon": "$(debug-stop)"
      },
      {
        "command": "acp.disconnectAgent",
        "title": "ACP: Disconnect Agent",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "acp.openChat",
        "title": "ACP: Open Chat View"
      },
      {
        "command": "acp.addAgent",
        "title": "ACP: Add Agent Configuration",
        "icon": "$(add)"
      },
      {
        "command": "acp.showOtherWorkspaces",
        "title": "ACP: Show Other Workspaces",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "acp.showAgents",
        "title": "ACP: Show This Workspace's Agents",
        "icon": "$(arrow-left)"
      },
      {
        "command": "acp.openSessionInWorkspace",
        "title": "ACP: Open Session in Its Workspace"
      },
      {
        "command": "acp.detectAgents",
        "title": "ACP: Detect Agents"
      },
      {
        "command": "acp.removeAgent",
        "title": "ACP: Remove Agent"
      },
      {
        "command": "acp.showLog",
        "title": "ACP: Show Log"
      },
      {
        "command": "acp.exportTraffic",
        "title": "ACP: Export Protocol Traffic"
      },
      {
        "command": "acp.showPersistedState",
        "title": "ACP (Developer): Show Persisted State"
      },
      {
        "command": "acp.resetPersistedState",
        "title": "ACP (Developer): Reset Persisted State"
      },
      {
        "command": "acp.setMode",
        "title": "ACP: Set Agent Mode"
      },
      {
        "command": "acp.setModel",
        "title": "ACP: Set Agent Model"
      },
      {
        "command": "acp.attachFile",
        "title": "ACP: Attach File to Prompt",
        "icon": "$(attach)"
      },
      {
        "command": "acp.refreshSessions",
        "title": "ACP: Refresh Sessions"
      },
      {
        "command": "acp.openSession",
        "title": "ACP: Open Session"
      },
      {
        "command": "acp.loadMoreSessions",
        "title": "ACP: Load More Sessions"
      },
      {
        "command": "acp.copySessionId",
        "title": "Copy Session ID"
      },
      {
        "command": "acp.removeFromHistory",
        "title": "Remove from History"
      },
      {
        "command": "acp.restartAgent",
        "title": "ACP: Restart Agent",
        "icon": "$(debug-restart)"
      },
      {
        "command": "acp.openToolCallFile",
        "title": "Open File"
      },
      {
        "command": "acp.openToolCallChanges",
        "title": "Open Changes"
      },
      {
        "command": "acp.openCommandOutput",
        "title": "Open in Terminal"
      },
      {
        "command": "acp.openReview",
        "title": "Open ACP Review",
        "icon": "$(diff)",
        "enablement": "acp.reviewShown && acp.reviewHasFiles && !acp.turnInProgress"
      },
      {
        "command": "acp.previousReviewFile",
        "title": "Previous File Under Review",
        "icon": "$(arrow-left)",
        "enablement": "acp.reviewShown && acp.reviewHasFiles"
      },
      {
        "command": "acp.nextReviewFile",
        "title": "Next File Under Review",
        "icon": "$(arrow-right)",
        "enablement": "acp.reviewShown && acp.reviewHasFiles"
      },
      {
        "command": "acp.undoFile",
        "title": "Undo File",
        "icon": "$(discard)",
        "enablement": "acp.reviewShown && resource in acp.reviewedFiles && !acp.turnInProgress"
      },
      {
        "command": "acp.keepFile",
        "title": "Keep File",
        "icon": "$(check)",
        "enablement": "acp.reviewShown && resource in acp.reviewedFiles && !acp.turnInProgress"
      },
      {
        "command": "acp.keepAllFiles",
        "title": "Keep All",
        "icon": "$(check-all)",
        "enablement": "acp.reviewShown && acp.reviewHasFiles && !acp.turnInProgress"
      },
      {
        "command": "acp.undoDiffChange",
        "title": "Undo Change",
        "icon": "$(discard)",
        "enablement": "acp.reviewDiffChange && !acp.turnInProgress"
      },
      {
        "command": "acp.keepDiffChange",
        "title": "Keep Change",
        "icon": "$(check)",
        "enablement": "acp.reviewDiffChange && !acp.turnInProgress"
      },
      {
        "command": "acp.undoChange",
        "title": "Undo Change",
        "icon": "$(discard)",
        "enablement": "!acp.turnInProgress"
      },
      {
        "command": "acp.keepChange",
        "title": "Keep Change",
        "icon": "$(check)",
        "enablement": "!acp.turnInProgress"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "acp.connectAgent",
          "when": "!acp.workspaceUnavailable"
        },
        {
          "command": "acp.newSession",
          "when": "!acp.workspaceUnavailable"
        },
        {
          "command": "acp.sendPrompt",
          "when": "!acp.workspaceUnavailable"
        },
        {
          "command": "acp.cancelTurn",
          "when": "!acp.workspaceUnavailable"
        },
        {
          "command": "acp.disconnectAgent",
          "when": "!acp.workspaceUnavailable"
        },
        {
          "command": "acp.openChat",
          "when": "!acp.workspaceUnavailable"
        },
        {
          "command": "acp.addAgent",
          "when": "!acp.workspaceUnavailable"
        },
        {
          "command": "acp.detectAgents",
          "when": "!acp.workspaceUnavailable"
        },
        {
          "command": "acp.removeAgent",
          "when": "!acp.workspaceUnavailable"
        },
        {
          "command": "acp.showLog",
          "when": "!acp.workspaceUnavailable"
        },
        {
          "command": "acp.exportTraffic",
          "when": "!acp.workspaceUnavailable"
        },
        {
          "command": "acp.showPersistedState",
          "when": "!acp.workspaceUnavailable"
        },
        {
          "command": "acp.resetPersistedState",
          "when": "!acp.workspaceUnavailable"
        },
        {
          "command": "acp.setMode",
          "when": "!acp.workspaceUnavailable"
        },
        {
          "command": "acp.setModel",
          "when": "!acp.workspaceUnavailable"
        },
        {
          "command": "acp.attachFile",
          "when": "!acp.workspaceUnavailable"
        },
        {
          "command": "acp.restartAgent",
          "when": "!acp.workspaceUnavailable"
        },
        {
          "command": "acp.openReview",
          "when": "!acp.workspaceUnavailable && acp.reviewShown && acp.reviewHasFiles"
        },
        {
          "command": "acp.keepDiffChange",
          "when": "false"
        },
        {
          "command": "acp.undoDiffChange",
          "when": "false"
        },
        {
          "command": "acp.refreshSessions",
          "when": "false"
        },
        {
          "command": "acp.showOtherWorkspaces",
          "when": "false"
        },
        {
          "command": "acp.showAgents",
          "when": "false"
        },
        {
          "command": "acp.openSessionInWorkspace",
          "when": "false"
        },
        {
          "command": "acp.openSession",
          "when": "false"
        },
        {
          "command": "acp.loadMoreSessions",
          "when": "false"
        },
        {
          "command": "acp.copySessionId",
          "when": "false"
        },
        {
          "command": "acp.removeFromHistory",
          "when": "false"
        },
        {
          "command": "acp.openToolCallFile",
          "when": "false"
        },
        {
          "command": "acp.openToolCallChanges",
          "when": "false"
        },
        {
          "command": "acp.openCommandOutput",
          "when": "false"
        },
        {
          "command": "acp.previousReviewFile",
          "when": "false"
        },
        {
          "command": "acp.nextReviewFile",
          "when": "false"
        },
        {
          "command": "acp.undoFile",
          "when": "false"
        },
        {
          "command": "acp.keepFile",
          "when": "false"
        },
        {
          "command": "acp.keepAllFiles",
          "when": "false"
        },
        {
          "command": "acp.undoChange",
          "when": "false"
        },
        {
          "command": "acp.keepChange",
          "when": "false"
        }
      ],
      "scm/change/title": [
        {
          "command": "acp.undoChange",
          "when": "originalResourceScheme == review-baseline",
          "group": "navigation@1"
        },
        {
          "command": "acp.keepChange",
          "when": "originalResourceScheme == review-baseline",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "acp.openReview",
          "when": "!acp.workspaceUnavailable && config.acp.review.presentation == diffEditor && acp.reviewShown && acp.reviewHasFiles && activeEditor == workbench.editors.files.textFileEditor && isFileSystemResource && !textCompareEditorActive",
          "group": "navigation@-1"
        },
        {
          "command": "acp.previousReviewFile",
          "when": "!acp.workspaceUnavailable && (config.acp.review.presentation == diffEditor && textCompareEditorActive && diffEditorOriginalUri =~ /^acp-review-diff:/ || config.acp.review.presentation == quickDiff && activeEditor == workbench.editors.files.textFileEditor)",
          "group": "navigation@-5"
        },
        {
          "command": "acp.nextReviewFile",
          "when": "!acp.workspaceUnavailable && (config.acp.review.presentation == diffEditor && textCompareEditorActive && diffEditorOriginalUri =~ /^acp-review-diff:/ || config.acp.review.presentation == quickDiff && activeEditor == workbench.editors.files.textFileEditor)",
          "group": "navigation@-4"
        },
        {
          "command": "acp.undoFile",
          "when": "!acp.workspaceUnavailable && (config.acp.review.presentation == diffEditor && textCompareEditorActive && diffEditorOriginalUri =~ /^acp-review-diff:/ || config.acp.review.presentation == quickDiff && activeEditor == workbench.editors.files.textFileEditor)",
          "group": "navigation@-3"
        },
        {
          "command": "acp.keepFile",
          "when": "!acp.workspaceUnavailable && (config.acp.review.presentation == diffEditor && textCompareEditorActive && diffEditorOriginalUri =~ /^acp-review-diff:/ || config.acp.review.presentation == quickDiff && activeEditor == workbench.editors.files.textFileEditor)",
          "group": "navigation@-2"
        },
        {
          "command": "acp.keepAllFiles",
          "when": "!acp.workspaceUnavailable && (config.acp.review.presentation == diffEditor && textCompareEditorActive && diffEditorOriginalUri =~ /^acp-review-diff:/ || config.acp.review.presentation == quickDiff && activeEditor == workbench.editors.files.textFileEditor)",
          "group": "navigation@-1"
        }
      ],
      "webview/context": [
        {
          "command": "acp.openToolCallFile",
          "when": "webviewId == 'acp-chat' && webviewSection == 'toolCallDiffFile'",
          "group": "navigation@1"
        },
        {
          "command": "acp.openToolCallChanges",
          "when": "webviewId == 'acp-chat' && webviewSection == 'toolCallDiffFile' && acpDiffFileHasLines",
          "group": "navigation@2"
        },
        {
          "command": "acp.openCommandOutput",
          "when": "webviewId == 'acp-chat' && webviewSection == 'commandOutput'",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "acp.showOtherWorkspaces",
          "when": "view == acp-sessions && !acp.showingOtherWorkspaces",
          "group": "navigation@0"
        },
        {
          "command": "acp.showAgents",
          "when": "view == acp-sessions && acp.showingOtherWorkspaces",
          "group": "navigation@0"
        },
        {
          "command": "acp.addAgent",
          "when": "!acp.workspaceUnavailable && !acp.showingOtherWorkspaces && view == acp-sessions",
          "group": "navigation@1"
        },
        {
          "command": "acp.newSession",
          "when": "view == acp-chat",
          "group": "navigation@1"
        },
        {
          "command": "acp.attachFile",
          "when": "view == acp-chat",
          "group": "navigation@2"
        },
        {
          "command": "acp.cancelTurn",
          "when": "view == acp-chat && acp.turnInProgress",
          "group": "navigation@3"
        },
        {
          "command": "acp.disconnectAgent",
          "when": "view == acp-chat",
          "group": "navigation@4"
        },
        {
          "command": "acp.showLog",
          "when": "view == acp-chat"
        },
        {
          "command": "acp.exportTraffic",
          "when": "view == acp-chat"
        },
        {
          "command": "acp.restartAgent",
          "when": "view == acp-chat"
        }
      ],
    "view/item/context": [
      {
        "command": "acp.newSession",
        "when": "view == acp-sessions && viewItem =~ /^agent/",
        "group": "session@0"
      },
        {
          "command": "acp.connectAgent",
          "when": "view == acp-sessions && viewItem == agent-without-session",
          "group": "inline"
        },
        {
          "command": "acp.disconnectAgent",
          "when": "view == acp-sessions && viewItem == agent-with-session",
          "group": "inline"
        },
        {
          "command": "acp.removeAgent",
          "when": "view == acp-sessions && viewItem =~ /^agent/"
        },
        {
          "command": "acp.restartAgent",
          "when": "view == acp-sessions && viewItem == agent-with-session"
        },
        {
          "command": "acp.refreshSessions",
          "when": "view == acp-sessions && viewItem =~ /^agent/",
          "group": "session@1"
        },
        {
          "command": "acp.copySessionId",
          "when": "view == acp-sessions && viewItem =~ /^session/",
          "group": "session@1"
        },
        {
          "command": "acp.removeFromHistory",
          "when": "view == acp-sessions && viewItem == session-local",
          "group": "session@2"
        }
      ]
    },
    "configurationDefaults": {
      "diffEditor.codeLens": true
    },
    "configuration": {
      "title": "ACP Client",
      "properties": {
        "acp.review.presentation": {
          "type": "string",
          "enum": [
            "quickDiff",
            "diffEditor"
          ],
          "default": "diffEditor",
          "description": "Review agent changes in a native diff editor with per-change CodeLens and editor title controls, or in the inline quick diff view."
        },
        "acp.agents": {
          "type": "object",
          "description": "Agent configurations. Each key is the agent name, value has command, args, and env.",
          "default": {}
        },
        "acp.autoApprovePermissions": {
          "type": "string",
          "enum": [
            "ask",
            "allowAll"
          ],
          "default": "ask",
          "description": "Automatically approve agent permission requests. 'ask' always prompts, 'allowAll' approves everything."
        },
        "acp.defaultWorkingDirectory": {
          "type": "string",
          "default": "",
          "description": "Default working directory for agent sessions. Leave empty to use the current workspace folder."
        },
        "acp.includeActiveFile": {
          "type": "boolean",
          "default": true,
          "description": "Attach the currently active editor file to each prompt as a resource_link content block."
        },
        "acp.logTraffic": {
          "type": "boolean",
          "default": true,
          "description": "Capture ACP protocol traffic in memory for explicit JSONL export."
        },
        "acp.showToolCallDiffs": {
          "type": "boolean",
          "default": false,
          "description": "Show the diffs an agent reports in its tool calls in the chat view: what the agent said each tool call changed, when it said it. Applies from the next tool call update."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run bundle",
    "bundle": "node esbuild.mjs",
    "check-types": "tsc -b",
    "package": "npm run check-types && node esbuild.mjs --production",
    "lint": "eslint . --max-warnings 0 && knip",
    "pretest": "npm run compile && npm run lint",
    "test": "vitest run && npm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:vitest": "vitest run",
    "test:webview": "vitest run --project webview",
    "test:integration": "node tools/run-integration.mjs",
    "test:ui": "playwright test --config playwright.config.mts",
    "coverage": "npm run check-types && npm run lint && vitest run --project unit --coverage",
    "coverage:unit": "vitest run --project unit --coverage",
    "coverage:integration": "npm run compile && npm run lint && node tools/run-integration.mjs --coverage"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.1.0",
    "@xterm/headless": "^6.0.0",
    "currency-codes": "^2.2.0",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "execa": "^10.2.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-diff-view": "^3.3.3",
    "react-dom": "^19.3.1",
    "streamdown": "^2.7.1",
    "to-words": "^7.4.1",
    "use-stick-to-bottom": "^1.1.6",
    "which": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "~1.140.0",
    "@types/vscode-webview": "^1.57.5",
    "@types/which": "^3.0.4",
    "@vitest/coverage-v8": "^5.0.5",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "mocha": "^11.8.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "knip": {
    "entry": [
      ".vscode-test.mjs",
      "tools/run-tests.mjs"
    ],
    "ignoreBinaries": [
      "make",
      "Xvfb"
    ]
  }
}
